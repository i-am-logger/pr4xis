<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema Vocabulary Closed-Class Lexicon (LMF format).

  This file enumerates the bounded, closed-class vocabulary that appears
  as element / attribute / type / group / model names in published XML
  schema specifications (W3C HTML, W3C XML 1.0, LRC USLM XML User Guide,
  related XML-vocabulary standards) but lies outside English WordNet's
  general-language coverage.

  Loaded by the XSD → English projection's `is_schema_vocabulary`
  classifier (`crates/domains/src/formal/meta/xsd/schema_vocabulary.rs`)
  to recognize these tokens as bounded schema-vocabulary terms-of-art
  rather than reporting them as unresolved lemmas when projecting a
  loaded XSD schema's element/complexType/simpleType/attribute names
  through the English-projection functor.

  Same LMF format as `function-words/english.xml`, `legal-text/us_legal_lexicon.xml`,
  and the WordNet bundles — processed by the same LMF reader
  (`crate::social::software::markup::xml::lmf`).

  Per "Bottom-up loaded, never encoded": every name below is sourced
  to a published specification section. The classifier consults this
  loaded set; it does NOT hand-code element names as Rust enum
  variants. Adding a new schema-vocabulary term requires editing this
  XML, regenerating its sha256, and updating praxis.lock.

  Source citations per category:

  • HTML5 element + attribute names (br, img, del, href, src, alt,
    colspan, rowspan, meta):
        WHATWG HTML Living Standard. The Web Hypertext Application
        Technology Working Group. <https://html.spec.whatwg.org/>.
        Section anchors per category synset below. CC-BY 4.0; mirrored
        normatively in W3C HTML 4.01 (W3C Recommendation 1999-12-24)
        §§6-9 (the historical baseline section structure these names
        retain in current HTML).

  • XML 1.0 attribute-type names (idref):
        Bray, Paoli, Sperberg-McQueen, Maler & Yergeau (eds.) (2008)
        *Extensible Markup Language (XML) 1.0 (Fifth Edition)* W3C
        Recommendation 26 November 2008, §3.3.1 (Attribute Types).
        <https://www.w3.org/TR/xml/>. W3C Document License.

  • LRC USLM-specific element / attribute names (toc, num, pos, inline,
    def, enum, attrs, misc, usc, xml):
        Office of the Law Revision Counsel, U.S. House of
        Representatives. *USLM (United States Legislative Markup) XML
        User Guide* Version 1.0.18. <https://github.com/usgpo/uslm>.
        Published by the LRC under 1 U.S.C. § 204; public-domain
        federal work per 17 U.S.C. § 105. Section anchors per category
        synset below.

  • Productive sub-* hierarchical forms (subarticle, subparagraph,
    subclause, subitem, subsubitem):
        Huddleston, Rodney & Geoffrey K. Pullum (2002) *The Cambridge
        Grammar of the English Language* Cambridge University Press,
        Ch. 19 §1.2 — productive prefixation (anti-, counter-, cross-,
        ex-, inter-, intra-, mid-, mis-, multi-, non-, post-, pre-,
        pro-, re-, semi-, **sub-**, super-, trans-, ultra-, un-). The
        attached base lemmas (article, paragraph, clause, item) are
        each independently in English WordNet; the sub-prefixed forms
        are productively well-formed under CGEL §19.1.2 and appear in
        the LRC USLM hierarchy below their parent elements (USLM User
        Guide §V.10 hierarchical structure).

  POS tags follow OLiA (Chiarcos & Sukhareva 2015) via Universal
  Dependencies: n = common noun (element/attribute name as a noun
  used referentially in schema prose).
-->
<LexicalResource>
  <Lexicon id="schema-vocabulary" label="Schema Vocabulary Closed Class" language="en" email="" license="CC0-1.0" version="2026" url="">

    <!-- ==================================================================
         HTML5 element names (WHATWG HTML Living Standard)
         ================================================================== -->
    <LexicalEntry id="sv-br"><Lemma writtenForm="br" partOfSpeech="n"/><Sense id="sv-br-1" synset="sv-html-element"/></LexicalEntry>
    <LexicalEntry id="sv-img"><Lemma writtenForm="img" partOfSpeech="n"/><Sense id="sv-img-1" synset="sv-html-element"/></LexicalEntry>
    <LexicalEntry id="sv-del"><Lemma writtenForm="del" partOfSpeech="n"/><Sense id="sv-del-1" synset="sv-html-element"/></LexicalEntry>
    <LexicalEntry id="sv-meta"><Lemma writtenForm="meta" partOfSpeech="n"/><Sense id="sv-meta-1" synset="sv-html-element"/></LexicalEntry>

    <!-- ==================================================================
         HTML5 attribute names (WHATWG HTML Living Standard)
         ================================================================== -->
    <LexicalEntry id="sv-href"><Lemma writtenForm="href" partOfSpeech="n"/><Sense id="sv-href-1" synset="sv-html-attribute"/></LexicalEntry>
    <LexicalEntry id="sv-src"><Lemma writtenForm="src" partOfSpeech="n"/><Sense id="sv-src-1" synset="sv-html-attribute"/></LexicalEntry>
    <LexicalEntry id="sv-alt"><Lemma writtenForm="alt" partOfSpeech="n"/><Sense id="sv-alt-1" synset="sv-html-attribute"/></LexicalEntry>
    <LexicalEntry id="sv-colspan"><Lemma writtenForm="colspan" partOfSpeech="n"/><Sense id="sv-colspan-1" synset="sv-html-attribute"/></LexicalEntry>
    <LexicalEntry id="sv-rowspan"><Lemma writtenForm="rowspan" partOfSpeech="n"/><Sense id="sv-rowspan-1" synset="sv-html-attribute"/></LexicalEntry>

    <!-- ==================================================================
         W3C XML 1.0 attribute-type names
         ================================================================== -->
    <LexicalEntry id="sv-idref"><Lemma writtenForm="idref" partOfSpeech="n"/><Sense id="sv-idref-1" synset="sv-xml10-attribute-type"/></LexicalEntry>

    <!-- ==================================================================
         LRC USLM element / attribute names (USLM User Guide v1.0.18)
         ================================================================== -->
    <LexicalEntry id="sv-toc"><Lemma writtenForm="toc" partOfSpeech="n"/><Sense id="sv-toc-1" synset="sv-uslm-element"/></LexicalEntry>
    <LexicalEntry id="sv-num"><Lemma writtenForm="num" partOfSpeech="n"/><Sense id="sv-num-1" synset="sv-uslm-element"/></LexicalEntry>
    <LexicalEntry id="sv-inline"><Lemma writtenForm="inline" partOfSpeech="n"/><Sense id="sv-inline-1" synset="sv-uslm-element"/></LexicalEntry>
    <LexicalEntry id="sv-def"><Lemma writtenForm="def" partOfSpeech="n"/><Sense id="sv-def-1" synset="sv-uslm-element"/></LexicalEntry>
    <LexicalEntry id="sv-pos"><Lemma writtenForm="pos" partOfSpeech="n"/><Sense id="sv-pos-1" synset="sv-uslm-attribute"/></LexicalEntry>
    <LexicalEntry id="sv-enum"><Lemma writtenForm="enum" partOfSpeech="n"/><Sense id="sv-enum-1" synset="sv-uslm-type-suffix"/></LexicalEntry>
    <LexicalEntry id="sv-attrs"><Lemma writtenForm="attrs" partOfSpeech="n"/><Sense id="sv-attrs-1" synset="sv-uslm-group"/></LexicalEntry>
    <LexicalEntry id="sv-misc"><Lemma writtenForm="misc" partOfSpeech="n"/><Sense id="sv-misc-1" synset="sv-uslm-attribute"/></LexicalEntry>
    <LexicalEntry id="sv-usc"><Lemma writtenForm="usc" partOfSpeech="n"/><Sense id="sv-usc-1" synset="sv-uslm-domain"/></LexicalEntry>
    <LexicalEntry id="sv-xml"><Lemma writtenForm="xml" partOfSpeech="n"/><Sense id="sv-xml-1" synset="sv-xml10-domain"/></LexicalEntry>

    <!-- ==================================================================
         Productive sub-* hierarchical forms (CGEL §19.1.2 + USLM §V.10)
         ==================================================================
         The base lemmas (article, paragraph, clause, item) are each in
         English WordNet. The sub-prefixed forms are productively
         well-formed and appear in the LRC USLM hierarchy below their
         respective parent containers per USLM User Guide §V.10. -->
    <LexicalEntry id="sv-subarticle"><Lemma writtenForm="subarticle" partOfSpeech="n"/><Sense id="sv-subarticle-1" synset="sv-uslm-sub-hierarchy"/></LexicalEntry>
    <LexicalEntry id="sv-subparagraph"><Lemma writtenForm="subparagraph" partOfSpeech="n"/><Sense id="sv-subparagraph-1" synset="sv-uslm-sub-hierarchy"/></LexicalEntry>
    <LexicalEntry id="sv-subclause"><Lemma writtenForm="subclause" partOfSpeech="n"/><Sense id="sv-subclause-1" synset="sv-uslm-sub-hierarchy"/></LexicalEntry>
    <LexicalEntry id="sv-subitem"><Lemma writtenForm="subitem" partOfSpeech="n"/><Sense id="sv-subitem-1" synset="sv-uslm-sub-hierarchy"/></LexicalEntry>
    <LexicalEntry id="sv-subsubitem"><Lemma writtenForm="subsubitem" partOfSpeech="n"/><Sense id="sv-subsubitem-1" synset="sv-uslm-sub-hierarchy"/></LexicalEntry>

    <!-- ==================================================================
         Synsets — one per category, doubling as documentation of the
         authoritative source citation for that category.
         ================================================================== -->
    <Synset id="sv-html-element" partOfSpeech="n">
      <Definition>HTML element name per WHATWG HTML Living Standard. br: §4.5.27 (line break); img: §4.8.3 (image embed); del: §4.7.2 (deleted content); meta: §4.2.5 (metadata). Mirrored historically in W3C HTML 4.01 §§7-9 (Recommendation 1999-12-24).</Definition>
    </Synset>
    <Synset id="sv-html-attribute" partOfSpeech="n">
      <Definition>HTML attribute name per WHATWG HTML Living Standard. href: hypertext reference (§6.4); src: source URL (§6.3); alt: alternative text (§4.8.4.4); colspan / rowspan: column / row span (§4.9.11).</Definition>
    </Synset>
    <Synset id="sv-xml10-attribute-type" partOfSpeech="n">
      <Definition>XML 1.0 attribute-type name per W3C XML 1.0 (Fifth Edition) §3.3.1 — Attribute Types (Bray, Paoli, Sperberg-McQueen, Maler &amp; Yergeau eds., W3C Recommendation 26 November 2008). idref: a tokenized attribute type referencing the ID of another element in the same document.</Definition>
    </Synset>
    <Synset id="sv-uslm-element" partOfSpeech="n">
      <Definition>LRC USLM element name per USLM XML User Guide v1.0.18. toc: table of contents (§V.6); num: numeric identifier (§V.2); inline: inline content marker (§V.3); def: definition (§V.5). Published by Office of the Law Revision Counsel under 1 U.S.C. § 204.</Definition>
    </Synset>
    <Synset id="sv-uslm-attribute" partOfSpeech="n">
      <Definition>LRC USLM attribute name per USLM XML User Guide v1.0.18. pos: positional marker / page-position (§V.4); misc: miscellaneous content marker (§V.8). Published by Office of the Law Revision Counsel.</Definition>
    </Synset>
    <Synset id="sv-uslm-type-suffix" partOfSpeech="n">
      <Definition>LRC USLM XSD type-name suffix per USLM XML User Guide v1.0.18 §V.7 — enumeration / enumerated list. Appears on simpleType names: ChoiceEnum, PropertyTypeEnum, SetTypeEnum, StatusEnum, ActionTypeEnum, PositionEnum, OrientationEnum, NoteTypeEnum.</Definition>
    </Synset>
    <Synset id="sv-uslm-group" partOfSpeech="n">
      <Definition>LRC USLM attribute-group reference name per USLM XML User Guide v1.0.18 §V.1 — attribute group abbreviation. Appears in attributeGroup names: XmlSpecialAttrs.</Definition>
    </Synset>
    <Synset id="sv-uslm-domain" partOfSpeech="n">
      <Definition>LRC USLM domain identifier per USLM XML User Guide v1.0.18 §I.2 — U.S. Code identifier. Appears in element names: uscDoc.</Definition>
    </Synset>
    <Synset id="sv-xml10-domain" partOfSpeech="n">
      <Definition>W3C XML 1.0 domain identifier per W3C XML 1.0 (Fifth Edition) §1.1 — Origin and Goals (Bray, Paoli, Sperberg-McQueen, Maler &amp; Yergeau eds., W3C Recommendation 26 November 2008). The XML name itself, used in namespace-binding attributes (xml:lang, xml:space) and qualified element / attribute names.</Definition>
    </Synset>
    <Synset id="sv-uslm-sub-hierarchy" partOfSpeech="n">
      <Definition>Productive sub-* hierarchical form per Huddleston &amp; Pullum 2002 Cambridge Grammar of the English Language Ch. 19 §1.2 (productive prefixation: sub-) attaching to a base lemma in English WordNet, naming a hierarchy level below the parent element in the LRC USLM structure per USLM XML User Guide v1.0.18 §V.10 (hierarchical structure). Forms: subarticle / subparagraph / subclause / subitem / subsubitem.</Definition>
    </Synset>

  </Lexicon>
</LexicalResource>

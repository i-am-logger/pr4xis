# published USLM.xsd (github.com/usgpo/uslm@main/USLM.xsd, version
# "1.0.18" on its <xsd:schema> root attribute). Loaded by the USLM
# ontology codegen so element/complexType/simpleType declarations
# derive from the published schema (Gao, Sperberg-McQueen & Thompson
# 2012 W3C XSD 1.1 Part 1 §1.1 Recommendation 5 April 2012) rather
# than being hand-coded.
"uslm_xsd@1.0.18"        = "blake3:721195b07384287a32c8feedce9e56c7e58a9bd847674949e1b5e6c1c0e69c79"

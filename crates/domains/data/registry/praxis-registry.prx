# In re Winship, 397 U.S. 358 (1970). Establishes BeyondReasonableDoubt as
# the constitutional standard for every element of a criminal offense.
# Primary source for the ProofStandard::BeyondReasonableDoubt concept's
# constitutional grounding.
[sources.in_re_winship_1970]
version     = "1970"
type        = "CaseLaw"
url         = "https://supreme.justia.com/cases/federal/us/397/358/"
description = "In re Winship, 397 U.S. 358 (1970) — BeyondReasonableDoubt as constitutional standard"

# Tumey v. Ohio, 273 U.S. 510 (1927). Establishes the judge-impartiality
# doctrine prohibiting overlapping Party / Adjudicator roles.
[sources.tumey_v_ohio_1927]
version     = "1927"
type        = "CaseLaw"
url         = "https://supreme.justia.com/cases/federal/us/273/510/"
description = "Tumey v. Ohio, 273 U.S. 510 (1927) — judge-impartiality doctrine"

# Lawson v. FMR LLC, 571 U.S. 429 (2014). Supreme Court extension of SOX

# Content addresses of the English STORE BUNDLE — the digest of each bundle's
# uncompressed FRAMED bytes (the nine BUILT English store buffers: five packed
# CSR buffers + four rkyv store envelopes, LEB128-framed; see
# english::store_bundle). TRUST CLASS: [archive_signatures], NOT
# [compact_archive_signatures] — four of the nine buffers are rkyv envelopes,
# so this is a per-toolchain BUILD-OUTPUT / CACHE pin (the STEP-0 doctrine
# above applies verbatim: it changes whenever the rkyv crate version /
# features, the rkyv on-disk layout, or the store packing changes). It is
# valid ONLY where emitter and consumer compile from one lockstep — the wasm
# binary whose build.rs emitted its embedded bundle, and the native
# .prx-cache/wordnet-stores fast tier — and is NEVER a published portable
# wire artifact (the succinct compact archive above stays the wire). The
# store-bundle load gate (lmf::prx::load_english_store_bundle_gz_gated)
# verifies the framed bytes against this pin before any store is admitted;
# behind the gate every store still runs its own fail-closed validator
# (from_untrusted_buf for the packed CSR stores, the bytecheck pass for the
# rkyv stores). Re-pinned mechanically from the value
# dump_wordnet_store_bundle_addresses reports (or `pr4xis compile --lock`);
# guarded by wordnet_store_bundle_anchors_match_lock.
[store_bundle_signatures]
"english_wordnet@2025" = "blake3:ee24c6a01c9f7622c56eb399f5dd6f5908fe8af022b6de366a5a0e9edf9a45be"

# Byte-exact round-trip signatures — the content digest of the bytes a source's
# graph-faithful lens regenerates under the STRICT byte-exact PutGet law
# (Foster, Greenwald, Moore, Pierce & Schmitt 2007 §2.2): the source
# regenerates from the typed ontology graph plus a content-addressed
# concrete-syntax complement, with NO stored raw blob. Because byte-exactness
# means `put(get(b)) == b`, the round-trip-output hash EQUALS the raw-source
# hash — so each value here MUST equal the source's `[hashes]` pin (the parser
# in registry.rs enforces this; a free-standing byte_exact_signature, or one
# that differs from `[hashes]`, is rejected at load time). This is a DURABLE
# identity pin (unlike the per-toolchain `[archive_signatures]` build-output
# pin above). `english_wordnet` is praxis's first byte-exact graph-faithful
# source (SLICE 3b, #186); `usc_title_1` is the first byte-exact graph-faithful
# USC title (SLICE U6, #186). Each round-trip harness verifies the byte-exact law
# against these pins.
[byte_exact_signatures]
"english_wordnet@2025"   = "blake3:d289d59559e5a479dce730b43a30e75d01a9516a451cd90999e756bd2206476c"
# US Federal Legal-Text Closed-Class Lexicon — praxis's SECOND byte-exact
# graph-faithful WN-LMF source (the lexical sibling of english_wordnet). The
# `WordNetLmfLens` regenerates the on-disk `us_legal_lexicon.xml` bytes from the
# typed `WordNet` ontology + the GENERIC concrete-syntax complement (DOCTYPE,
# namespaces, white-space, attribute order, entity-reference form, AND the new
# CHILD-ORDER permutation residue — a no-op here, the source is DTD-ordered), with
# NO stored raw blob and NO stored DOM. Because `put(get(b)) == b`, the byte-exact
# round-trip output hash equals the raw source content hash — i.e. this value MUST
# equal the `us_legal_lexicon@2026` `[hashes]` pin (registry.rs enforces
# sig == raw_hash).
"us_legal_lexicon@2026"  = "blake3:59397b5d42712554ed5eed9be26a23854c2b19cf9fb2051b9b63daa3cbac9b38"
# english_function_words — the THIRD WN-LMF graph-faithful source. The
# source-agnostic `WordNetLmfLens` regenerates the on-disk english.xml bytes
# from the typed `WordNet` ontology + the concrete-syntax complement (the source
# is DTD-ordered, so the child-order residue is a no-op), with NO stored raw blob.
# Because `put(get(b)) == b`, this value MUST equal the
# `english_function_words@2026` `[hashes]` pin (registry.rs enforces sig == raw_hash).
"english_function_words@2026"  = "blake3:3c903026f069d306c8912580dc5e51ae8ffaed68906516313cbd8e8cad5541e8"
# USC Title 1 — General Provisions. The `UslmGraphFaithfulLens` regenerates the
# literal on-disk `usc01.xml` bytes (CRLFs included) from the typed `UsCodeTitle`
# ontology + a concrete-syntax complement, so the byte-exact round-trip output
# hash equals the raw source content hash — i.e. this value MUST equal the
# `usc_title_1@pl-119-90` `[hashes]` pin (registry.rs enforces sig == raw_hash).
"usc_title_1@pl-119-90"  = "blake3:3e97f66096b6b4198e73bef8f0ad5d532cf298b54cf81839fa1b46bdfe885d1e"
# CiTO 2.8.1 — praxis's FIRST byte-exact graph-faithful OWL vocabulary (#36 Leg
# 2). The `OwlGraphFaithfulLens` regenerates the on-disk `cito-2.8.1.owl` bytes
# from the typed `OwlOntology` graph + a STRUCTURED RDF/XML serialization
# complement (the node-block/property-element striping + the namespace,
# white-space, attribute, entity, EOL residue), with NO stored raw blob and NO
# stored DOM. Because `put(get(b)) == b`, the byte-exact round-trip output hash
# equals the raw source content hash — i.e. this value MUST equal the
# `cito@2.8.1` `[hashes]` pin (registry.rs enforces sig == raw_hash).
"cito@2.8.1"             = "blake3:58061b9db3e5c1739f1e17691597f6178bda0fb62d7801d57bee72185d2ebbdd"
# BiRO 1.1.1, C4O 1.2, DoCO 1.3 — the flat-serialised SPAR OWL family, flipped to
# byte-exact graph-faithful alongside cito. Each serialises every node (named and
# blank) as a top-level <rdf:Description> with leaf property elements (no
# parseType, no DOCTYPE, no comments, no numeric character references, no DTD
# entities), so the OwlGraphFaithfulLens regenerates the on-disk bytes from the
# typed OwlOntology graph + the STRUCTURED RDF/XML serialization complement, with
# NO stored raw blob and NO stored DOM. Because put(get(b)) == b, each value MUST
# equal that vocab's `[hashes]` pin (registry.rs enforces sig == raw_hash).

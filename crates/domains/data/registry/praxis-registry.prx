description = "Murray v. UBS Securities, LLC, 601 U.S. 23 (2024) — contributing-factor standard"
��# praxis.lock — pinned content digests for entries in praxis.toml.
# Cargo-precedent naming. Auto-managed (regenerated by
# `pr4xis update --lock` / `pr4xis compile --lock`); manual edits will
# be overwritten.
#
# Value grammar — every value is a tagged digest, `<algorithm>:<64
# lowercase hex>`:
#   - `blake3:<hex>` — BLAKE3 (Aumasson, O'Connor, Neves &
#     Wilcox-O'Hearn 2020), the ONE algorithm praxis emits content
#     addresses under. All praxis-written pins carry this tag.
#   - `sha256:<hex>` — an explicit SHA-256 pin (NIST FIPS 180-4).
#   - bare `<hex>` — loadable as SHA-256 (the untagged form).
# Any other tag is rejected at parse time (fail-closed, the tag is
# named). Verification dispatches under the algorithm the pin names —
# emit-one / verify-many.
#
# Two parallel sections:
#
# `[hashes]` — content digest of the source bytes as delivered by the
# fetch pipeline (after transport-layer decompression, before any
# decoder runs). Keys are `"<name>@<version>"` strings matching
# `[sources.<name>] version` in praxis.toml. Verifies "we got the same
# source we expected" (Dolstra 2006 content-addressed storage).
#
# `[canonical_signatures]` — content digest of the canonical-form
# bytes produced by the source's well-behaved lens (Foster, Greenwald,
# Moore, Pierce & Schmitt 2007 ACM TOPLAS 29(3)). The canonical form
# is the lens's normalized output — W3C XML Canonicalization 1.1
# (Boyer & Marcy 2008) for USLM/XML sources, W3C RDF Dataset
# Canonicalization (RDFC-1.0, REC-rdf-canon-20240521) serialized
# N-Quads of the source RDF graph for OWL/RDF sources, RFC 8785 JCS
# for JSON, Unicode NFKC for plain text, etc. (RDFC-1.0's INTERNAL
# blank-node hashing is SHA-256 per the W3C spec; the pin here is
# praxis's digest OVER the canonical bytes it emits.) Verifies "the
# source, after lens normalization, has the same structural shape" —
# drift in the lens implementation surfaces here while the raw-bytes
# digest remains stable. Optional per source; sources without a
# signature are not yet round-trip-pinned.
#
# Drift detection: the LockManifestAgreement axiom compares each
# manifest entry to its lock digest. Missing lock entry, extra lock
# entry, or mismatching digest all fail closed at startup. A free-
# standing canonical_signature without a matching raw-bytes digest is
# rejected at parse time.

[hashes]
"english_wordnet@2025"   = "blake3:d289d59559e5a479dce730b43a30e75d01a9516a451cd90999e756bd2206476c"
# USLM XML schema (W3C XSD 1.1). Pinned hash of the on-disk file

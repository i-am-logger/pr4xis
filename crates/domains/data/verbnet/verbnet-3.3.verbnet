                                <ARG type="ThemRole" value="Attribute"/>
                            </ARGS>
                        </PRED>
                    </SEMANTICS>
                </FRAME>
	    </FRAMES>
	    <SUBCLASSES/>
	</VNSUBCLASS>
    </SUBCLASSES>
</VNCLASS>

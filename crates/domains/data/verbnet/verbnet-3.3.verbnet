                        <ARG type="ThemRole" value="Agent"/>
                        <ARG type="ThemRole" value="Instrument"/>
                    </ARGS>
                </PRED>
            </SEMANTICS>
        </FRAME>
        <FRAME>
            <DESCRIPTION descriptionNumber="1.3" primary="NP V PP" secondary="Conative" xtag=""/>

        <MEMBER name="semaphore" wn="semaphore%2:32:01 semaphore%2:32:00" grouping=""/>
        <MEMBER name="sign" wn="sign%2:32:01 sign%2:32:04" grouping="sign.02"/>
        <MEMBER name="signal" wn="signal%2:32:00" grouping="signal.01"/>

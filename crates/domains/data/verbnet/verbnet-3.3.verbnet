                        <ARG type="ThemRole" value="Extent"/>
                        <ARG type="Constant" value="ch_of_loc"/>
                        <ARG type="VerbSpecific" value="prep"/>  
                    </ARGS>
                </PRED>
            </SEMANTICS>
        </FRAME>
        <FRAME>
            <DESCRIPTION descriptionNumber="0.1" primary="NP V ADV-Middle"
            secondary="Middle construction" xtag=""/>
            <!--strongly prefers prep "around"-->

# Rust/Cargo
target/

# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Editor
.vscode/
.idea/

# Internal tracking
roadmap.md

# WASM build artifacts (regenerated by wasm-pack)
crates/wasm/pkg/
docs/chat/pkg/
# On-demand source documents staged by crates/wasm/build.rs (copies of the
# registered USC title USLM XML; served at /sources/<file>)
crates/wasm/sources/
# .prx.gz distribution artifacts emitted by the `emit_prx` example (#256).
# Build outputs published to the GitHub release + Pages /ontologies/, never
# committed (rkyv wire layout is toolchain-dependent; the canonical source
# of truth stays the bundled .owl + its praxis.lock pin).
dist/
# E2E click-to-load staging: same `.prx.gz` artifacts, emitted into the
# pr4xis-web tree so the local/CI dual-load test has them at /ontologies/.
crates/wasm/ontologies/
# Parse-once corpus cache: `.prx.gz` archives emitted by `pr4xis compile`
# and read by the corpus loader instead of re-parsing source XML per
# process. Build output, never committed; CI restores it from the
# praxis.lock-keyed data cache.
.prx-cache/

# Managed external data — fetched via `pr4xis update`, never committed
crates/domains/data/wordnet/*.xml
crates/domains/data/wordnet/*.xml.gz
# U.S. Code USLM XML titles (uscode.house.gov, fetched as zip per
# release point, extracted to per-title XML files).
crates/domains/data/legal/uscode/**/*.xml
crates/domains/data/legal/uscode/**/*.xml.gz
crates/domains/data/legal/uscode/**/*.zip
# W3C XML Schema Test Suite — 4.2 MB tar.gz, ~14k schema files,
# fetched via `pr4xis update`. SHA-256 pinned in praxis.lock.
crates/domains/data/markup-schemas/xsts/*.tar.gz
crates/domains/data/markup-schemas/xsts/xmlschema2006-11-06/
# W3C XML 1.0 Conformance Test Suite (XMLConf) — 624 KB tar.gz,
# ~3,000 XML test files. SHA-256 pinned in praxis.lock.
crates/domains/data/markup-schemas/xmlconf/*.tar.gz
crates/domains/data/markup-schemas/xmlconf/xmlconf/

# Claude Code transient files
.claude/scheduled_tasks.lock

# cargo-mutants output — per-run, regenerated by dev-mutants
mutants.out/
